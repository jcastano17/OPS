# Copia a .env.supabase (excluido de Git). Nunca pegues contraseñas en el chat.

# Solo diagnóstico administrativo de lectura; NO se usa como usuario de la aplicación.
SUPABASE_ADMIN_DATABASE_URL=postgresql://postgres.zghnxmwahzbyqpetldfv:REEMPLAZAR@aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require

# Completar tras crear los roles propios de Guía y aplicar sus migraciones.
# No apuntar GUIA_DATABASE_URL al usuario postgres ni usar service_role en el cliente.
GUIA_DATABASE_URL=
GUIA_DATABASE_OWNER_URL=
GUIA_DATABASE_POOL_SIZE=3

# La identidad vigente de Guía usa JWT propio. Supabase Auth no se activa por este archivo.
