# MATERIAL HISTÓRICO (revisión 2026-11-18). Plantilla preparada en octubre de 2026
# para una prueba de conexión al proyecto Supabase entonces candidato. Guía (main)
# usa PostgreSQL en Azure; este archivo NO es necesario para esa arquitectura y se
# conserva solo como registro, con sus valores sin modificar. Ver docs/SUPABASE.md.
# El servidor Node de la demostración usa SQLite, no estas variables de conexión.
# Si alguna vez se usó una copia local (.env.supabase, excluida de Git), nunca pegues
# contraseñas en el chat.

# Solo diagnóstico administrativo de lectura; NO se usa como usuario de la aplicación.
SUPABASE_ADMIN_DATABASE_URL=postgresql://postgres.zghnxmwahzbyqpetldfv@aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require
# Parámetro previsto para la contraseña privada de PostgreSQL, separado de la URL.
# Se conserva como marcador histórico; no es un requisito de la operación en Azure.
SUPABASE_DATABASE_PASSWORD=REEMPLAZAR

# Histórico: estaban previstas para después de crear roles propios de Guía y aplicar
# migraciones en Supabase, pasos no realizados al corte del 2026-10-03. Criterio para
# cualquier PostgreSQL: no apuntar la aplicación al superusuario ni exponer claves
# privilegiadas en el cliente.
GUIA_DATABASE_URL=
GUIA_DATABASE_OWNER_URL=
GUIA_DATABASE_POOL_SIZE=3

# La identidad vigente de Guía usa JWT propio. Supabase Auth no se activa por este archivo.
# Los secretos JWT y de auditoría existentes se conservan en el entorno de Guía.
