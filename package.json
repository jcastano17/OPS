{
  "name": "vivir-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Radicación y revisión de cuentas de cobro OPS para VIVIR",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "demo": "DEMO_MODE=1 node server.js",
    "demo:finance": "DEMO_MODE=1 node scripts/demo-finance.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9"
  }
}
